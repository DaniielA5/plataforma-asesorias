spring.application.name=asesorias

  
spring.datasource.url=jdbc:postgresql://localhost:5432/asesorias_db
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=org.postgresql.Driver

# ===== JPA / Hibernate =====
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true


# Clave HMAC en Base64 de 32 bytes o más. Para generarla en PowerShell:
# $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
app.jwt.secreto=
app.jwt.minutos=120


# ===== Servidor =====
server.port=8080

# ===== Correo (Postfix local en el VPS, vía Mailgun) =====
# En desarrollo local no hace falta: no hay Postfix corriendo, no configures esto en tu máquina.
spring.mail.host=localhost
spring.mail.port=25
app.correo.remitente=no-reply@mg.juarez.top