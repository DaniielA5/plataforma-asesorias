spring.application.name=asesorias

  
spring.datasource.url=jdbc:postgresql://localhost:5432/asesorias_db
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=org.postgresql.Driver

# ===== JPA / Hibernate =====
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true


# Clave HMAC en Base64 de 32 bytes o más. Para generarla en PowerShell:
# $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
app.jwt.secreto=
app.jwt.minutos=120


# ===== Servidor =====
server.port=8080

# ===== Correo (Postfix local en el VPS, vía Mailgun) =====
# En desarrollo local no hace falta: no hay Postfix corriendo, no configures esto en tu máquina.
spring.mail.host=localhost
spring.mail.port=25
app.correo.remitente=no-reply@mg.juarez.top

# ===== Frontend (para los enlaces de los correos) =====
app.frontend.url=http://localhost:5173


# ===== Twilio (SMS y WhatsApp) =====
# Con habilitado=false se usa NotificacionSimulada, que solo escribe en el log.
app.twilio.habilitado=false
app.twilio.account-sid=
app.twilio.auth-token=
app.twilio.numero-sms=
app.twilio.numero-whatsapp=

# Cuenta de prueba: Twilio solo acepta plantillas predefinidas. Con cuenta de pago, déjalo vacío para mandar el texto real.
app.twilio.plantilla-sms=
# Cuenta de prueba: WhatsApp no acepta texto libre, solo plantillas (ContentSid).
# Ejemplo de la documentación de Twilio (Appointment Reminder): HXb5b62575e6e4ff6129ad7c8efe1f983e
# Con cuenta de pago, déjalo vacío para mandar el texto real.
app.twilio.content-sid-whatsapp=

# ===== Google (iniciar sesión con Google) =====
# ID de cliente web de Google Cloud (no es secreto). Vacío = el acceso con Google queda apagado.
app.google.client-id=